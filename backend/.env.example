# ---------- core ----------
FINCORE_ENVIRONMENT=development          # development | test | staging | production
FINCORE_DEBUG=false
FINCORE_DATABASE_URL=postgresql+psycopg://fincore:fincore@localhost:5432/fincore
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FINCORE_SECRET_KEY=change-me
FINCORE_ENCRYPTION_KEY=change-me-too     # encrypts webhook secrets + 2FA seeds; use a KMS-managed value in prod
FINCORE_PUBLIC_BASE_URL=http://localhost:8000
FINCORE_FRONTEND_BASE_URL=http://localhost:5173
FINCORE_CORS_ORIGINS=["http://localhost:5173"]
FINCORE_ACCESS_TOKEN_TTL_MINUTES=15
FINCORE_REFRESH_TOKEN_TTL_DAYS=14
FINCORE_RATE_LIMIT_PER_MINUTE=300
FINCORE_AUTH_RATE_LIMIT_PER_MINUTE=20

# ---------- real-money switch ----------
# Keep false until provider contracts, Bank of Ghana authorisation and production credentials exist.
FINCORE_LIVE_PAYMENTS_ENABLED=false
# Adapter per rail once live (MTN is set by FINCORE_MTN_MOMO_MODE): sandbox | telecel_cash | at_money | ghipss
FINCORE_ROUTE_TELECEL=sandbox
FINCORE_ROUTE_AT=sandbox
FINCORE_ROUTE_BANK=sandbox

# ---------- MTN MoMo Collections (https://momodeveloper.mtn.com) ----------
# Two completely separate credential sets. FINCORE_MTN_MOMO_MODE picks one:
#   off        -> MTN numbers use the labelled simulator (development only)
#   sandbox    -> MTN developer sandbox: real MTN API, TEST money, no prompts on real phones
#   production -> real money; requires production keys from MTN Ghana AND FINCORE_LIVE_PAYMENTS_ENABLED=true
# Never put production keys in the sandbox variables (or vice versa); FinCore refuses mixed URLs/modes.
FINCORE_MTN_MOMO_MODE=off
FINCORE_MTN_SANDBOX_BASE_URL=https://sandbox.momodeveloper.mtn.com
FINCORE_MTN_SANDBOX_COLLECTION_SUBSCRIPTION_KEY=
FINCORE_MTN_SANDBOX_COLLECTION_API_USER=
FINCORE_MTN_SANDBOX_COLLECTION_API_KEY=
FINCORE_MTN_SANDBOX_DISBURSEMENT_SUBSCRIPTION_KEY=
FINCORE_MTN_SANDBOX_DISBURSEMENT_API_USER=
FINCORE_MTN_SANDBOX_DISBURSEMENT_API_KEY=
FINCORE_MTN_SANDBOX_CALLBACK_URL=
FINCORE_MTN_PRODUCTION_BASE_URL=https://proxy.momoapi.mtn.com
FINCORE_MTN_PRODUCTION_TARGET_ENVIRONMENT=mtnghana
FINCORE_MTN_PRODUCTION_COLLECTION_SUBSCRIPTION_KEY=
FINCORE_MTN_PRODUCTION_COLLECTION_API_USER=
FINCORE_MTN_PRODUCTION_COLLECTION_API_KEY=
FINCORE_MTN_PRODUCTION_DISBURSEMENT_SUBSCRIPTION_KEY=
FINCORE_MTN_PRODUCTION_DISBURSEMENT_API_USER=
FINCORE_MTN_PRODUCTION_DISBURSEMENT_API_KEY=
# e.g. https://api.example.com/api/v1/callbacks/mtn_momo?token=<FINCORE_MTN_CALLBACK_TOKEN>
FINCORE_MTN_PRODUCTION_CALLBACK_URL=
FINCORE_MTN_CALLBACK_TOKEN=
FINCORE_MTN_REQUEST_EXPIRY_MINUTES=15

# ---------- Paystack (licensed gateway; MoMo for MTN/Telecel/AT + bank transfers) ----------
FINCORE_PAYSTACK_SECRET_KEY=

# ---------- partner specs required (see docs/PAYMENT_PROVIDERS.md) ----------
FINCORE_TELECEL_CASH_BASE_URL=
FINCORE_TELECEL_CASH_CLIENT_ID=
FINCORE_TELECEL_CASH_CLIENT_SECRET=
FINCORE_AT_MONEY_BASE_URL=
FINCORE_AT_MONEY_CLIENT_ID=
FINCORE_AT_MONEY_CLIENT_SECRET=
FINCORE_GHIPSS_BASE_URL=
FINCORE_GHIPSS_INSTITUTION_CODE=
FINCORE_GHIPSS_API_KEY=

FINCORE_INVESTMENTS_ENABLED=false

# ---------- private file storage (KYC documents) ----------
FINCORE_STORAGE_BACKEND=local             # local (dev) | s3 (production: AWS S3 or any S3-compatible store)
FINCORE_STORAGE_LOCAL_DIR=var/storage
FINCORE_STORAGE_S3_BUCKET=                # bucket must block all public access
FINCORE_STORAGE_S3_REGION=
FINCORE_STORAGE_S3_ENDPOINT_URL=          # only for non-AWS S3-compatible stores
FINCORE_STORAGE_S3_ACCESS_KEY_ID=
FINCORE_STORAGE_S3_SECRET_ACCESS_KEY=
FINCORE_STORAGE_SIGNED_URL_TTL_SECONDS=300
FINCORE_KYC_MAX_UPLOAD_BYTES=5242880

# ---------- cards (acquiring bank, from the merchant/acquiring agreement) ----------
FINCORE_CARD_ACQUIRER=bank_card           # used only when FINCORE_LIVE_PAYMENTS_ENABLED=true
FINCORE_CARD_ACQUIRER_BASE_URL=
FINCORE_CARD_ACQUIRER_MERCHANT_ID=
FINCORE_CARD_ACQUIRER_API_KEY=
FINCORE_CARD_ACQUIRER_WEBHOOK_SECRET=
